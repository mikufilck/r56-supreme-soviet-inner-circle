# =============================================================================
# 核心圈窗口本体
# -----------------------------------------------------------------------------
# 由 build/gen-hof-ic-gui.ps1 生成 —— 勿手改，改布局请改那个脚本里的常量表。
#
# 画布 760 x 740；席位头像按 0.60、领袖头像按 0.53 缩放。
#
# ⚠️ 三条硬规矩（都是踩坑后加的，别改）：
#   1. 所有元素的 orientation 一律 upper_left，y 从容器顶部算；
#      水平居中由 (容器宽 - 素材宽)/2 显式算出。混用 center / center_up
#      会让 y 变成"从容器中心算"，表现是底板与文字错位。
#   2. 内容必须落在画布之内（生成器会断言）。
#   3. 底板美术铺满画布，四周无透明边；矩形肖像必须缩入框内。
#
# sprite 走 GFX_hof_ic_* 间接层（见 interface/hof_ic.gfx）。
# =============================================================================

guiTypes = {

	containerWindowType = {
		name = "hof_ic_ui_window"
		orientation = lower_left
		position = { x = 0 y = 0 }
